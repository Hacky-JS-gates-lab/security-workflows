{
  "name": "ORG-fleet-audit",
  "url": "https://github.com/ORG",
  "description": "Read-only identity for the daily fleet audit in security-workflows. Reads org and repo settings; writes nothing.",
  "public": false,
  "hook_attributes": { "url": "https://example.invalid/no-webhook", "active": false },
  "redirect_url": "https://example.invalid/",
  "default_permissions": {
    "metadata": "read",
    "contents": "read",
    "administration": "read",
    "actions": "read",
    "secret_scanning_alerts": "read",
    "organization_administration": "read",
    "members": "read"
  },
  "default_events": []
}
